---
import Layout from "../layouts/Layout.astro";
import { App } from "../app/App";
---

<Layout title="ProScale">
  <App client:only />
</Layout>
<style>
  html {
    background-color: #0c0c0c;
  }
  body {
    margin: 0;
    padding: 0;
    width: 100vw;
    height: calc(100vh - calc(100vh - 100%));
    background-color: #0c0c0c;
    color: #fff;
    box-sizing: border-box;
  }
</style>
